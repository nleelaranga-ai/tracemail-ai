# ==============================================================================
# TraceMail AI — Environment Configuration Template
# Copy this file to .env or .env.local — NEVER commit actual API keys to git!
# ==============================================================================

# Application Environment
APP_NAME=TraceMail AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Frontend Configuration
# Backend API gateway URL for Next.js client requests.
# Set to http://localhost:8000 for live backend or leave empty for standalone mock/demo mode.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service Port Bindings
BACKEND_PORT=8000
THREAT_INTEL_PORT=8001
AI_ENGINE_PORT=8002
FRONTEND_PORT=3000

# Service URLs
BACKEND_URL=http://localhost:8000
THREAT_INTEL_URL=http://localhost:8001
AI_ENGINE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# Central Database (PostgreSQL 16)
DATABASE_URL=postgresql://tracemail:tracemail_secret@localhost:5432/tracemail_db

# Neo4j Graph Database (Attack Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracemail_neo4j

# JWT Authentication
JWT_SECRET=tracemail-hackathon-jwt-secret-key-sih26106
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Cybersecurity Threat Intelligence APIs
# Note: Free tier keys are sufficient. If left blank, the system uses realistic mock heuristics.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=
URLSCAN_API_KEY=

# LLM Explainer Provider
GROQ_API_KEY=

# Operational Flags
USE_MOCK_THREAT_INTEL=true

# Google Maps Platform Configuration (SIH 2026)
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_DIRECTIONS_URL=https://maps.googleapis.com/maps/api/directions/json
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 & Gmail API Configuration (Live Inbox Scanner)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/inbox
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

