# TraceMail AI — Environment Variables
# Copy to .env and fill in values before running docker compose

# ── Database ──────────────────────────────────────────────────
POSTGRES_PASSWORD=tracemail_dev_secret

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production

# ── App Environment ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
NODE_ENV=production

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
