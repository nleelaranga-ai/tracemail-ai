# ============================================================
# TraceMail AI — Team Reports: Docker
# File: team_reports/docker/Dockerfile.backend
#
# Multi-stage Docker image for the FastAPI backend + Reports Engine.
# Stage 1: builder  — install deps in isolation
# Stage 2: runtime  — minimal production image
#
# WeasyPrint system dependencies (libpango, libcairo) are installed
# in the runtime stage for PDF generation.
#
# Build:  docker build -f team_reports/docker/Dockerfile.backend -t tracemail-ai/backend .
# Run:    docker run -p 8000:8000 tracemail-ai/backend
# ============================================================

# ── Stage 1: Builder ─────────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY team_reports/requirements.txt requirements.txt
RUN pip install --upgrade pip && \
    pip install --prefix=/install --no-cache-dir -r requirements.txt

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM python:3.12-slim-bookworm AS runtime

LABEL maintainer="SIH26106 Team Reports — Reports & QA"
LABEL org.opencontainers.image.title="TraceMail AI Backend"
LABEL org.opencontainers.image.description="FastAPI backend + Reports Engine"
LABEL org.opencontainers.image.version="1.0.0"

# WeasyPrint system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libffi-dev \
    shared-mime-info \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Non-root user for security
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

# Copy application code
COPY --chown=appuser:appgroup . .

USER appuser

# Environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    LOG_LEVEL=info \
    PYTHONPATH=/app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--log-level", "info", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
